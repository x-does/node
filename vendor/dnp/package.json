{
  "name": "definitely-not-pong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "serve:static": "npx http-server ./client -p 4173 -c-1",
    "create-site": "node scripts/create-site.mjs",
    "deploy": "node scripts/deploy-hostinger.mjs",
    "pixel-summary": "node scripts/pixel-snapshot.mjs",
    "check": "node --check server/index.mjs && node --check server/config.mjs && node --check server/protocol.mjs && node --check server/room-manager.mjs && node --check client/js/app.js && node --check client/js/ui.js",
    "start:mounted": "BASE_PATH=/dnp node server/index.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "nanoid": "^5.1.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "exports": {
    ".": "./server/index.mjs",
    "./server": "./server/index.mjs",
    "./client/*": "./client/*"
  }
}
