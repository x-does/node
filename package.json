{
  "name": "x-does-node-next",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/patch-standalone-dnp.mjs",
    "start": "node server.mjs",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "deploy:preflight": "bash scripts/deploy-preflight.sh",
    "deploy:preflight:check": "bash scripts/deploy-preflight.sh --check-only",
    "verify:live": "bash scripts/verify-live-audit-surface.sh",
    "verify:live:readonly": "bash scripts/verify-live-audit-surface.sh --skip-click",
    "verify:audit:readonly": "bash scripts/verify-live-audit-surface.sh --skip-click --skip-root",
    "verify:audit:regression": "bash scripts/verify-audit-regression.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@workos-inc/node": "^8.10.0",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "next": "^16.2.1",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "nanoid": "^5.1.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
